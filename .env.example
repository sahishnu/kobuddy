HOSTNAME=0.0.0.0
PORT=3000
DATA_PATH=./data
DATABASE_FILE=app.sqlite
# Optional: override path to Drizzle SQL migrations (default: monorepo packages/db/migrations)
# MIGRATIONS_PATH=/app/packages/db/migrations

INGEST_TOKEN=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-at-least-8-chars
SESSION_SECRET=change-me-at-least-32-characters-long-secret

PUBLIC_READ=true
MAX_COVER_MB=5
AUTO_FETCH_COVERS=false
# Recommended for ISBN/cover search (Google returns 429 without a key).
# GOOGLE_BOOKS_API_KEY=

REQUIRED_PLUGIN_VERSION=0.1.0
# Optional: books-per-year target shown on the dashboard (integer).
# READING_GOAL_BOOKS=12
NODE_ENV=development
