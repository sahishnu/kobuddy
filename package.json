{
  "name": "kobuddy",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.3",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kobuddy/db exec drizzle-kit generate",
    "db:studio": "pnpm --filter @kobuddy/db exec drizzle-kit studio",
    "seed:dev": "pnpm --filter @kobuddy/server run seed:dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
